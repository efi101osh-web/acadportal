// =============================================
// ACADPORTAL — FIREBASE FIRESTORE RULES
// =============================================
// PASTE THIS into:
// Firebase Console → Firestore Database → Rules
// Replace kDqtQszCQpeu0TfurPKvXdnOcTD2 with your UID
// =============================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }
    function isProfessor() {
      return request.auth != null &&
             request.auth.uid == "kDqtQszCQpeu0TfurPKvXdnOcTD2";
    }
    function isStudent() {
      return request.auth != null &&
             request.auth.uid != "kDqtQszCQpeu0TfurPKvXdnOcTD2";
    }
    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // USERS
    match /users/{userId} {
      allow read: if isLoggedIn() && (isOwner(userId) || isProfessor());
      allow create: if isLoggedIn() && isOwner(userId);
      allow update: if isLoggedIn() && (isOwner(userId) || isProfessor());
      allow delete: if isProfessor();
    }

    // COURSES
    match /courses/{courseId} {
      allow read: if isLoggedIn();
      allow write: if isProfessor();
    }

    // NOTES
    match /notes/{noteId} {
      allow read: if isLoggedIn();
      allow create, update, delete: if isProfessor();
    }

    // ASSIGNMENTS
    match /assignments/{assignmentId} {
      allow read: if isLoggedIn();
      allow create, update, delete: if isProfessor();
    }

    // SUBMISSIONS
    match /submissions/{submissionId} {
      allow read: if isLoggedIn() && (
        isProfessor() ||
        resource.data.studentUid == request.auth.uid
      );
      allow create: if isStudent() &&
        request.resource.data.studentUid == request.auth.uid;
      allow update: if isLoggedIn() && (
        isProfessor() ||
        (isStudent() && resource.data.studentUid == request.auth.uid)
      );
      allow delete: if isProfessor();
    }

    // SCORES ARCHIVE
    match /scores_archive/{scoreId} {
      allow read: if isLoggedIn() && (
        isProfessor() ||
        resource.data.studentUid == request.auth.uid
      );
      allow write: if isProfessor();
    }

    // NOTIFICATIONS
    match /notifications/{notifId} {
      allow read: if isLoggedIn();
      allow create: if isProfessor();
      allow update: if isLoggedIn();
      allow delete: if isProfessor();
    }
  }
}
